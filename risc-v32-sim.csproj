<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>risc_v32_sim</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <NoWarn>$(NoWarn);CA1305</NoWarn>
    
    <!-- -Werror -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- It is too annoying on the early stages  -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS0169;CS0414;CS0649</WarningsNotAsErrors>

    <!-- -Wall: all compiler warnings, including the newest "warning waves" -->
    <WarningLevel>9999</WarningLevel>

    <!-- -Wextra: the .NET code analyzers -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- also enforce your .editorconfig style rules at build time -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
